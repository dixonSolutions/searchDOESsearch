{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "gi://Gio":     ["./node_modules/@girs/gio-2.0/gio-2.0.d.ts"],
      "gi://GLib":    ["./node_modules/@girs/glib-2.0/glib-2.0.d.ts"],
      "gi://GObject": ["./node_modules/@girs/gobject-2.0/gobject-2.0.d.ts"],
      "gi://Adw":     ["./node_modules/@girs/adw-1/adw-1.d.ts"],
      "gi://Gtk":     ["./node_modules/@girs/gtk-4.0/gtk-4.0.d.ts"],
      "gi://St":      ["./node_modules/@girs/st-17/st-17.d.ts"],
      "gi://Clutter": ["./node_modules/@girs/clutter-17/clutter-17.d.ts"],
      "gi://Cogl":    ["./node_modules/@girs/cogl-17/cogl-17.d.ts"],
      "gi://*":       ["./node_modules/@girs/*/index.d.ts"],
      "resource:///org/gnome/shell/extensions/extension.js": [
        "./node_modules/@girs/gnome-shell/src/extensions/extension.d.ts"
      ],
      // Capitalised and nested under js/ — this is the path the Shell actually
      // ships, and the key must match the import exactly or a wrong path
      // type-checks cleanly and then fails at runtime, which is how a broken
      // prefs import once shipped. scripts/check-resource-imports.js verifies
      // the path against the installed gresource bundle.
      "resource:///org/gnome/Shell/Extensions/js/extensions/prefs.js": [
        "./node_modules/@girs/gnome-shell/src/extensions/prefs.d.ts"
      ],
      "resource:///org/gnome/shell/ui/animation.js": [
        "./node_modules/@girs/gnome-shell/src/ui/animation.d.ts"
      ],
      "resource:///org/gnome/shell/ui/main.js": [
        "./node_modules/@girs/gnome-shell/src/ui/main.d.ts"
      ],
      "resource://*": ["./node_modules/@girs/gnome-shell/src/*"]
    },
    "types": ["@girs/gjs"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
